# Gnani AI provider configuration
PRISMA_API_KEY=your_gnani_api_key
PRISMA_MODEL=prisma-v3.0
PRISMA_LANGUAGE_CODE=indic-auto
PRISMA_FORMAT=verbatim
TIMBRE_API_KEY=your_gnani_api_key
TIMBRE_MODEL=timbre-v2.5
TIMBRE_VOICE=Nalini
TIMBRE_LANGUAGE=auto
GNANI_REQUEST_TIMEOUT_SECONDS=60
MAX_AUDIO_UPLOAD_BYTES=10485760

# Evon local Transformers configuration.
EVON_MODEL_ID=gnani/gnani-evon-v3.3-30B-A3B
EVON_INFERENCE_MODE=local
EVON_ENABLED=true
EVON_DEVICE_MAP=auto
EVON_MODEL_CACHE_DIR=./model_cache
EVON_MAX_NEW_TOKENS=256
EVON_MAX_CONCURRENT_REQUESTS=1
EVON_INFERENCE_TIMEOUT_SECONDS=120

# MongoDB Connection
MONGODB_URI=your_mongodb_connection_string
DATABASE_NAME=saanidhya

# JWT Authentication
JWT_SECRET_KEY=replace_with_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS / Frontend Application Origin
FRONTEND_URL=http://localhost:5173
