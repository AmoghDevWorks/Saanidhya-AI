# Gnani AI configuration
# The official Prisma, Evon, and Timbre endpoint/authentication contracts are
# required before these adapters can make provider requests.
GNANI_API_KEY=your_gnani_api_key

# MongoDB Connection
MONGODB_URI=your_mongodb_connection_string
DATABASE_NAME=saanidhya

# JWT Authentication
JWT_SECRET_KEY=replace_with_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS / Frontend Application Origin
FRONTEND_URL=http://localhost:5173
